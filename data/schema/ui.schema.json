{
  "$defs": {
    "BriefComponent": {
      "additionalProperties": false,
      "description": "Evidence brief: verdict, evidence, gap, next steps and one text per audience.",
      "properties": {
        "type": {
          "const": "brief",
          "title": "Type",
          "type": "string"
        },
        "verdict": {
          "description": "One confident sentence of what the data shows",
          "minLength": 1,
          "title": "Verdict",
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/BriefEvidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "gap": {
          "anyOf": [
            {
              "$ref": "#/$defs/BriefGap"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_steps": {
          "items": {
            "$ref": "#/$defs/BriefStep"
          },
          "maxItems": 3,
          "title": "Next Steps",
          "type": "array"
        },
        "lenses": {
          "$ref": "#/$defs/BriefLenses"
        }
      },
      "required": [
        "type",
        "verdict",
        "evidence",
        "gap",
        "next_steps",
        "lenses"
      ],
      "title": "BriefComponent",
      "type": "object"
    },
    "BriefEvidence": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "description": "Rows copied from a recorded query; one cell per column",
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        },
        "experiment_ids": {
          "description": "Experiments of these rows to highlight on the map",
          "items": {
            "pattern": "^PSI-\\d+$",
            "type": "string"
          },
          "title": "Experiment Ids",
          "type": "array"
        }
      },
      "required": [
        "title",
        "columns",
        "rows",
        "experiment_ids"
      ],
      "title": "BriefEvidence",
      "type": "object"
    },
    "BriefGap": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "What is missing, in one plain sentence",
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "pressure_kpa_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pressure Kpa Min"
        },
        "pressure_kpa_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pressure Kpa Max"
        },
        "o2_percent_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "O2 Percent Min"
        },
        "o2_percent_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "O2 Percent Max"
        },
        "gravity": {
          "anyOf": [
            {
              "enum": [
                "microgravity",
                "lunar",
                "martian",
                "normal"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gravity"
        }
      },
      "required": [
        "description",
        "pressure_kpa_min",
        "pressure_kpa_max",
        "o2_percent_min",
        "o2_percent_max",
        "gravity"
      ],
      "title": "BriefGap",
      "type": "object"
    },
    "BriefLenses": {
      "additionalProperties": false,
      "properties": {
        "student": {
          "description": "Concept in plain language plus one thinking question",
          "minLength": 1,
          "title": "Student",
          "type": "string"
        },
        "teacher": {
          "description": "Short class activity: hypothesis, variables, what to observe",
          "minLength": 1,
          "title": "Teacher",
          "type": "string"
        },
        "researcher": {
          "description": "Rigor: ranges, assumptions, o2_basis, sources to check",
          "minLength": 1,
          "title": "Researcher",
          "type": "string"
        }
      },
      "required": [
        "student",
        "teacher",
        "researcher"
      ],
      "title": "BriefLenses",
      "type": "object"
    },
    "BriefStep": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "simulate",
            "propose_experiment",
            "explore_map"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "description": "Short action label in Spanish",
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "pressure_kpa": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pressure Kpa"
        },
        "o2_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "O2 Percent"
        },
        "gravity": {
          "anyOf": [
            {
              "enum": [
                "microgravity",
                "lunar",
                "martian",
                "normal"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gravity"
        },
        "material": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Material"
        }
      },
      "required": [
        "kind",
        "label",
        "pressure_kpa",
        "o2_percent",
        "gravity",
        "material"
      ],
      "title": "BriefStep",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "experiment_id": {
          "pattern": "^PSI-\\d+$",
          "title": "Experiment Id",
          "type": "string"
        },
        "source_file": {
          "minLength": 1,
          "title": "Source File",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Section"
        },
        "quote": {
          "description": "Verbatim text from the document",
          "maxLength": 600,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "experiment_id",
        "source_file",
        "section",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    },
    "CitationsComponent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "citations",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "CitationsComponent",
      "type": "object"
    },
    "GapMapComponent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "gap_map",
          "title": "Type",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "experiment_ids": {
          "description": "Experiments to highlight on the map; empty means show all",
          "items": {
            "pattern": "^PSI-\\d+$",
            "type": "string"
          },
          "title": "Experiment Ids",
          "type": "array"
        },
        "gravity_environment": {
          "anyOf": [
            {
              "enum": [
                "microgravity",
                "lunar",
                "martian",
                "partial",
                "normal"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Filter the map to one gravity level",
          "title": "Gravity Environment"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the gap is, in one sentence",
          "title": "Note"
        }
      },
      "required": [
        "type",
        "title",
        "experiment_ids",
        "gravity_environment",
        "note"
      ],
      "title": "GapMapComponent",
      "type": "object"
    },
    "NoticeComponent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "notice",
          "title": "Type",
          "type": "string"
        },
        "level": {
          "enum": [
            "info",
            "warning"
          ],
          "title": "Level",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "type",
        "level",
        "message"
      ],
      "title": "NoticeComponent",
      "type": "object"
    },
    "TableComponent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "table",
          "title": "Type",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "description": "Each row has one cell per column",
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "type",
        "title",
        "columns",
        "rows"
      ],
      "title": "TableComponent",
      "type": "object"
    },
    "TextComponent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "text",
          "title": "Type",
          "type": "string"
        },
        "body": {
          "description": "Plain text answer in Spanish, a few sentences",
          "minLength": 1,
          "title": "Body",
          "type": "string"
        }
      },
      "required": [
        "type",
        "body"
      ],
      "title": "TextComponent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "summary": {
      "description": "One or two sentences in Spanish answering the question",
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "components": {
      "items": {
        "discriminator": {
          "mapping": {
            "brief": "#/$defs/BriefComponent",
            "citations": "#/$defs/CitationsComponent",
            "gap_map": "#/$defs/GapMapComponent",
            "notice": "#/$defs/NoticeComponent",
            "table": "#/$defs/TableComponent",
            "text": "#/$defs/TextComponent"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TextComponent"
          },
          {
            "$ref": "#/$defs/TableComponent"
          },
          {
            "$ref": "#/$defs/GapMapComponent"
          },
          {
            "$ref": "#/$defs/CitationsComponent"
          },
          {
            "$ref": "#/$defs/NoticeComponent"
          },
          {
            "$ref": "#/$defs/BriefComponent"
          }
        ]
      },
      "maxItems": 7,
      "minItems": 1,
      "title": "Components",
      "type": "array"
    }
  },
  "required": [
    "summary",
    "components"
  ],
  "title": "UIPayload",
  "type": "object"
}
