# Local development only. Copy to .env and never commit .env.
DATABASE_URL=postgresql://atlas:atlas@localhost:5433/atlas
DATA_DIR=data
CORS_ORIGINS=["http://localhost:3000"]
VOYAGE_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Search (role 2): also used by the researcher agent
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSION=1024
RERANK_MODEL=rerank-2.5
RERANK_CANDIDATES=30

# Agents for /query (see curren_repo_context/env.md)
AGENTS_MOCK=0
COMPOSITOR_MODE=agent
INVESTIGADOR_MODE=agent
CLASSIFIER_MODEL=claude-haiku-5-5
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=low
# LLM_PROVIDER=azure_openai runs the agents on a GPT deployment instead of Claude.
# Minimal setup: provider, key, base URL (Azure v1 API, no api version) and deployment name.
LLM_PROVIDER=claude
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_DEPLOYMENT=
# Alternative to AZURE_OPENAI_BASE_URL: endpoint plus api version
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
# Optional (none, minimal, low, medium or high) for every agent; empty = none for the classifier, AGENT_EFFORT for the rest
AZURE_OPENAI_REASONING_EFFORT=
QUERY_CACHE_ENABLED=1
QUERY_CACHE_FILE=data/query_cache.json
