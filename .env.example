# Browser-safe Supabase settings. `supabase status` prints the local values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Prisma runtime: use Supavisor transaction mode (port 6543) in Vercel.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Prisma introspection: use a direct connection (port 5432 remotely).
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional server-only key for local integration tooling. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Atlas: public demo needs no external services. Use remote only when FastAPI is ready.
ATLAS_DATA_MODE=demo
# Server-only base URL; exposes GET /experiments and POST /query (SSE).
ATLAS_API_URL=http://127.0.0.1:8000
