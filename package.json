{
  "name": "plantilla",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "supabase:start": "pnpm dlx supabase@2.115.0 start",
    "supabase:stop": "pnpm dlx supabase@2.115.0 stop",
    "db:reset": "pnpm dlx supabase@2.115.0 db reset",
    "db:diff": "pnpm dlx supabase@2.115.0 db diff",
    "db:push:dry": "pnpm dlx supabase@2.115.0 db push --dry-run",
    "db:types": "pnpm dlx supabase@2.115.0 gen types typescript --local > src/server/db/database.types.ts",
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "prisma:sync": "pnpm prisma:pull && pnpm prisma:generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "motion": "^14.14.0",
    "next": "16.3.2",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "three": "^0.187.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "dotenv": "^18.0.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.2",
    "prettier": "^3.10.1",
    "prisma": "7.9.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.11"
  }
}
