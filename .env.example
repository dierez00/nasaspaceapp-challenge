# Atlas frontend configuration. Copy to .env.local for local development and set
# the same variables in the Vercel project for Preview and Production.

# demo   = map and copilot run on bundled synthetic data; no backend needed.
# remote = map and copilot read the NASA PSI catalog from the FastAPI backend (GET /experiments).
ATLAS_DATA_MODE=demo

# remote = the copilot asks the FastAPI agents (POST /query, SSE); otherwise it gives
# guided answers computed from the catalog. Only used with ATLAS_DATA_MODE=remote.
ATLAS_QUERY_MODE=guided

# Server-only base URL of the FastAPI backend (branch `backend`), without a trailing slash.
# Local: http://127.0.0.1:8000 · Production: the public Railway domain, e.g. https://atlas-api.up.railway.app
ATLAS_API_URL=http://127.0.0.1:8000
